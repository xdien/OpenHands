{
	"mcpServers": {
		"playwright": {
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@0.0.38"
			],
			"alwaysAllow": [
				"browser_navigate",
				"browser_wait_for",
				"browser_type",
				"browser_click",
				"browser_snapshot",
				"browser_fill_form",
				"browser_network_requests",
				"browser_console_messages",
				"browser_press_key",
				"browser_close",
				"browser_evaluate"
			]
		}
	}
}
