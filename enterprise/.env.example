# OpenHands Enterprise Configuration

# Backend Port Configuration
BACKEND_PORT=3009

# Force SaaS mode for web client config
OH_APP_MODE=saas

# Configuration Class
OPENHANDS_CONFIG_CLS=server.config.SaaSServerConfig
OPENHANDS_CONVERSATION_VALIDATOR_CLS=storage.saas_conversation_validator.SaasConversationValidator

# Analytics and Security
POSTHOG_CLIENT_KEY=dummy_key_for_testing
JWT_SECRET=test_secret

# Redis configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=R3d1s@S3cur3#2026!Key
REDIS_CACHE_ENABLED=true
REDIS_DB=0
REDIS_TTL=3600

#== DATABASE CONFIGURATION
# PostgreSQL Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=Kj8mP3xR9nQ2vL5wY7zT4bN6hF1dS0cU
DB_NAME=openhands
DB_SYNCHRONIZE=false

# Discord Integration
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_PUBLIC_KEY=your_discord_public_key
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_WEBHOOKS_ENABLED=1

# Keycloak Configuration (DISABLED - using custom enterprise backend)
KEYCLOAK_ENABLE=false
# KEYCLOAK_SERVER_URL=http://localhost:8080
# KEYCLOAK_SERVER_URL_EXT=https://canthotouring.com
# KEYCLOAK_REALM_NAME=allhands
# KEYCLOAK_CLIENT_ID=openhands
# KEYCLOAK_CLIENT_SECRET=openhands-secret
# KEYCLOAK_ADMIN_PASSWORD=admin

# Enterprise Authentication Configuration (custom backend at iot.canthotouring.com)
ENTERPRISE_AUTH_URL=https://iot.canthotouring.com
ENTERPRISE_AUTH_URL_EXT=https://iot.canthotouring.com
ENTERPRISE_AUTH_JWT_SECRET=your_jwt_secret_here

# Enterprise SSO OAuth2 Configuration
ENTERPRISE_SSO_AUTH_URL=https://iot.canthotouring.com
ENTERPRISE_SSO_CLIENT_ID=allhands
ENTERPRISE_SSO_CLIENT_SECRET=your_oauth2_secret_here

# Identity Providers Configuration
# Enable Enterprise SSO with custom auth URL
ENABLE_ENTERPRISE_SSO=true
AUTH_URL=https://iot.canthotouring.com

# Frontend Configuration
FRONTEND_DIRECTORY=/home/xdien/workspace/OpenHands/frontend/build
WEB_HOST=ai.canthotouring.com

# Sandbox Configuration
# IMPORTANT: Use server's LAN IP so both health checks and frontend can connect
RUNTIME=docker
SANDBOX_CONTAINER_URL_PATTERN=http://192.168.1.92:{port}
# Increase startup grace period for slower machines (default is 15 seconds)
SANDBOX_STARTUP_GRACE_SECONDS=60
# Limit to 1 sandbox at a time to avoid port conflicts with host network mode
SANDBOX_MAX_NUM_SANDBOXES=1
# Use host network mode - containers bind directly to host ports (8000, 8001, etc.)
AGENT_SERVER_USE_HOST_NETWORK=true
